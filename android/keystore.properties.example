# Kopieer naar `android/keystore.properties` en vul in. Dat bestand staat in
# .gitignore en mag NOOIT in git belanden.
#
# Aanmaken van de keystore (eenmalig, bewaar het wachtwoord in een kluis):
#
#   keytool -genkeypair -v \
#     -keystore gymrebel-upload.jks \
#     -alias gymrebel \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Bewaar `gymrebel-upload.jks` BUITEN de repo, met een back-up op een tweede
# plek. Raak je 'm kwijt, dan kun je nooit meer een update van deze app
# publiceren; de enige uitweg is een nieuwe listing zonder je reviews en
# installaties. Zet Play App Signing aan, dan is dit alleen je *upload*-sleutel
# en kan Google die desnoods resetten.
#
# Op CI vul je in plaats hiervan de omgevingsvariabelen:
#   ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD,
#   ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD

storeFile=../gymrebel-upload.jks
storePassword=
keyAlias=gymrebel
keyPassword=
